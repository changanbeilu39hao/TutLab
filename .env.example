# ============================================================
# 学生管理系统 · 环境变量模板
# ------------------------------------------------------------
# 用法：
#   1. 复制为 .env（本地）
#   2. 前端用到的必须是 VITE_ 前缀，会被打进 bundle，只能放 anon key
#   3. service_role / JWT secret / DeepSeek key 只允许出现在 Worker 侧
#   4. 生产环境不要读 .env，用 wrangler secret put 注入
#   5. .env 已加入 .gitignore；仓库里只保留本文件
# ============================================================

# ── 应用 ─────────────────────────────────────────────────────
APP_NAME=TutLab
# 业务时区，前后端统一按这个算"今天"
APP_TZ=Australia/Melbourne
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────
# 本地：`supabase start` 会打印一组本地值，直接粘贴到这里
# 远程：Supabase Dashboard → Project Settings → API
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# 仅在 Worker / 迁移脚本中使用，绝不下发前端
SUPABASE_SERVICE_ROLE_KEY=
# 用于 Worker 侧校验用户 JWT（Dashboard → API → JWT Settings）
SUPABASE_JWT_SECRET=
# 直连数据库，用于 migration / seed / psql
# 本地默认：postgresql://postgres:postgres@127.0.0.1:54322/postgres
# 远程：Dashboard → Database → Connection string (URI)，注意用 pooler 端口 6543
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 前端可见（Vite 会内联进 bundle，必须是 anon key）
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ── Cloudflare ───────────────────────────────────────────────
# Dashboard → 右上角账户 ID
CLOUDFLARE_ACCOUNT_ID=
# My Profile → API Tokens，需要权限：
#   Account · Cloudflare Pages · Edit
#   Account · Workers Scripts · Edit
#   Zone · DNS · Edit（仅绑定自定义域名时需要）
CLOUDFLARE_API_TOKEN=
# Pages 项目名（会变成 <name>.pages.dev）
CF_PAGES_PROJECT=austin-student-ops
# Worker 名（会变成 <name>.<account>.workers.dev）
CF_WORKER_NAME=austin-api
# 前端调用 API 的基地址：本地 http://127.0.0.1:8787，生产填 Worker 域名
VITE_API_BASE_URL=http://127.0.0.1:8787

# ── DeepSeek（LLM）────────────────────────────────────────────
# platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 超时后必须走降级，不要无限等待
LLM_TIMEOUT_MS=12000
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2

# ── 演示：视角切换 ───────────────────────────────────────────
# 管理员切到老师视角时签发的短时令牌有效期（分钟），不可续期
IMPERSONATION_TTL_MIN=30

# ── 本地端口 ─────────────────────────────────────────────────
WEB_PORT=5173
API_PORT=8787

# ── 可选：演示与调试 ─────────────────────────────────────────
# 打开后 API 会在响应里带上 LLM 的原始返回，方便面试演示排查
DEBUG_LLM=false

# ── 演示账号（seed 脚本读取；生产环境请删掉整段）────────────────
# 密码统一，账号见 BUILD_PROMPT.md §2.5
SEED_PASSWORD=Passw0rd!
SEED_MANAGER_EMAIL=boss@tutorial.local
SEED_ADMIN_EMAIL=kiki@tutorial.local
SEED_ADMIN_2_EMAIL=jason@tutorial.local
SEED_TEACHER_EMAIL=kevin@tutorial.local
SEED_TEACHER_2_EMAIL=lisa@tutorial.local
SEED_TEACHER_3_EMAIL=amy@tutorial.local
